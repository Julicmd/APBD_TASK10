@typeparam TItem

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>@Header</tr>
    </thead>
    <tbody>
        @if (Items is null || !Items.Any())
        {
            <tr><td colspan="99" class="text-center text-muted fst-italic">No records found.</td></tr>
        }
        else
        {
            @foreach (var item in Items)
            {
                <tr>@Row(item)</tr>
            }
        }
    </tbody>
</table>

@code {
    [Parameter, EditorRequired] public IEnumerable<TItem>? Items { get; set; }
    [Parameter, EditorRequired] public RenderFragment Header { get; set; } = null!;
    [Parameter, EditorRequired] public RenderFragment<TItem> Row { get; set; } = null!;
}
